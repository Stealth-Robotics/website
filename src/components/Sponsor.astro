---
import { sponsor, contact } from "@/data/site"
// Until the booster club picks a donation processor, giving starts with an email.
const mail = `mailto:${contact.boosters}?subject=${encodeURIComponent("Sponsoring Stealth for 2026–27")}`
const arrow = `<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h13M9.5 3.5 15 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"></path></svg>`
---

<section class="sponsor" id="sponsor" aria-labelledby="sponsor-title">
  <div class="wrap">
    <div class="top">
      <h2 id="sponsor-title" class="title">{sponsor.title}</h2>
      <div class="pitch">
        <p set:html={sponsor.pitch} />
        <div class="actions">
          <a class="btn btn-paper" href={sponsor.primaryHref}>{sponsor.primary}<Fragment set:html={arrow} /></a>
          <a class="btn btn-ink" href={mail}>{sponsor.secondary}</a>
        </div>
      </div>
    </div>

    <h3 class="t-label builds-title">{sponsor.buildsTitle}</h3>
    <ul class="builds">
      {
        sponsor.builds.map((b) => (
          <li>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="sponsors">
      <h3 class="t-label">{sponsor.sponsorsTitle}</h3>
      <ul>{sponsor.sponsors.map((s) => <li set:html={s.name} />)}</ul>
      <a class="more link" href={sponsor.sponsorsHref}>{sponsor.sponsorsLink}</a>
    </div>
  </div>
</section>

<style>
  .sponsor {
    position: relative; background: var(--red); color: #fff;
    padding: calc(var(--section-y) + 3rem) 0 var(--section-y);
    clip-path: polygon(0 4rem, 100% 0, 100% 100%, 0 100%);
    margin-top: -4rem;
  }
  .top { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3rem; align-items: end; }
  .title {
    font-size: clamp(3rem, 1.4rem + 5.2vw, 6rem); font-weight: 900; font-stretch: 62%; line-height: 0.88; text-transform: uppercase; text-wrap: balance;
  }
  .pitch { display: grid; gap: 1.75rem; font-size: var(--text-lead); line-height: 1.5; font-stretch: 92%; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .builds-title { color: rgba(255, 255, 255, 0.82); margin-top: 4rem; }
  .builds { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; margin-top: 1.25rem; }
  .builds li { padding-top: 1rem; box-shadow: inset 0 2px 0 #fff; }
  .builds h3 { font-weight: 900; font-stretch: 70%; font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
  .builds p { margin-top: 0.5rem; color: rgba(255, 255, 255, 0.86); font-size: var(--text-small); max-width: 30ch; }
  .sponsors { margin-top: 4rem; padding: 2rem; background: var(--red-deep); clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px); }
  .sponsors .t-label { color: rgba(255, 255, 255, 0.78); }
  .sponsors ul { display: flex; flex-wrap: wrap; gap: 0.6rem 2rem; margin-top: 1rem; }
  .sponsors li { font-weight: 800; font-stretch: 80%; font-size: 1.15rem; text-transform: uppercase; letter-spacing: 0.02em; }
  .more { display: inline-block; margin-top: 1.5rem; font-weight: 750; font-size: 0.875rem; letter-spacing: 0.08em; text-transform: uppercase; }
  @media (max-width: 899px) {
    .sponsor { clip-path: polygon(0 2rem, 100% 0, 100% 100%, 0 100%); margin-top: -2rem; }
    .top { grid-template-columns: 1fr; }
    .builds { grid-template-columns: 1fr 1fr; }
    .actions .btn { flex: 1 1 100%; }
  }
</style>

---
import { teams } from "@/data/site"
---

<section class="section teams" id="teams" aria-labelledby="teams-title">
  <div class="wrap">
    <header class="head">
      <h2 id="teams-title" class="t-h2">{teams.title}</h2>
    </header>

    <ul class="cards">
      {
        teams.list.map((t) => (
          <li class="card">
            <figure class="frame chamfer shot frame-hover">
              <img src={t.photo} alt={t.photoAlt} loading="lazy" decoding="async" />
            </figure>
            <div class="decal">
              <img src={t.logo} alt={`${t.name} logo`} loading="lazy" />
            </div>
            <p class="id t-stat"><span class="prog">{t.program}</span> {t.number}</p>
            <h3 class="t-h3">{t.name}</h3>
            <p class="since t-label">{t.since}</p>
            <p class="text" set:html={t.text} />
          </li>
        ))
      }
    </ul>

    <div class="retired">
      <p class="t-label">{teams.retired.label}</p>
      <ul>
        {
          teams.retired.items.map((r) => (
            <li>
              {r.logo ? <img src={r.logo} alt="" loading="lazy" /> : <span class="blank" aria-hidden="true" />}
              <span><b class="t-stat">{r.number}</b> {r.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .teams { background: var(--hull-1); }
  .head { margin-bottom: 3.5rem; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .card { position: relative; display: flex; flex-direction: column; }
  .shot { aspect-ratio: 4 / 3; }
  .shot img { object-position: 50% 45%; }
  .decal {
    position: relative; margin: -2.75rem 0 1.25rem 1rem; width: max-content; max-width: 70%; height: 5.5rem;
    padding: 0.85rem 1.1rem; background: var(--hull-0); display: grid; place-items: center;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  }
  .decal img { height: 3.8rem; width: auto; max-width: 14rem; object-fit: contain; }
  .id { font-size: 1.05rem; color: var(--ink-3); letter-spacing: 0.08em; }
  .id .prog { color: var(--red-hot); }
  .card h3 { margin-top: 0.35rem; }
  .since { margin-top: 0.5rem; }
  .text { margin-top: 0.9rem; color: var(--ink-2); max-width: 34ch; }

  .retired { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--seam); display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.5rem; }
  .retired ul { display: flex; flex-wrap: wrap; gap: 1rem 2.25rem; }
  .retired li { display: flex; align-items: center; gap: 0.75rem; color: var(--ink-3); font-size: var(--text-small); }
  .retired img { height: 2rem; width: auto; filter: grayscale(1) brightness(1.4) contrast(0.8); opacity: 0.7; }
  .retired .blank { width: 2rem; height: 2rem; box-shadow: inset 0 0 0 1px var(--seam); }
  .retired b { color: var(--ink-2); font-size: 1.05rem; margin-right: 0.2rem; }

  @media (max-width: 899px) {
    .cards { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>

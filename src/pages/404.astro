---
import Layout from "@/layouts/main.astro"
import Nav from "@/components/Nav.astro"
import Footer from "@/components/Footer.astro"

const links = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Robots", href: "/robots" },
  { label: "Sponsors", href: "/sponsors" },
  { label: "Donate", href: "/donate" },
]
---

<Layout title="Page not found · Stealth Robotics" description="That page doesn't exist on the Stealth Robotics site.">
  <div class="top">
    <Nav />
  </div>
  <main id="main">
    <section class="lost" aria-labelledby="lost-title">
      <div class="wrap">
        <p class="code t-stat">404</p>
        <h1 id="lost-title" class="t-display">Off the <span class="red">field</span></h1>
        <p class="t-lead">That page doesn't exist, or it moved when we rebuilt the site. Try one of these instead.</p>
        <ul class="links">
          {links.map((l) => <li><a class="btn btn-ghost" href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .top { position: relative; z-index: 10; }
  /* hull-1 so the footer's facet steps down from it, as on every other page. */
  .lost { background: var(--hull-1); padding: calc(88px + clamp(3rem, 1rem + 8vw, 7rem)) 0 var(--section-y); }
  .code { font-size: clamp(3rem, 2rem + 4vw, 5rem); color: var(--red-hot); }
  .lost h1 { margin-top: 0.5rem; }
  .lost .t-lead { margin-top: 1.5rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  @media (max-width: 899px) {
    .links li { flex: 1 1 calc(50% - 0.75rem); }
    .links .btn { width: 100%; }
  }
</style>

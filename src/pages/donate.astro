---
import Layout from "@/layouts/main.astro"
import Nav from "@/components/Nav.astro"
import Footer from "@/components/Footer.astro"
import { sponsor, donatePage as page, contact } from "@/data/site"

// Giving questions and the sponsor packet go to the booster club's own address.
const packet = `mailto:${contact.boosters}?subject=${encodeURIComponent("Sponsor information packet")}`
const ext = `<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"></path></svg>`
const arrow = `<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h13M9.5 3.5 15 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"></path></svg>`
---

<Layout title={page.meta.title} description={page.meta.description} image="/photos/team-banner-field.jpg">
  <div class="top">
    <Nav />
  </div>

  <main id="main">
    <section class="intro" aria-labelledby="sponsor-title">
      <div class="wrap grid">
        <div class="copy">
          <h1 id="sponsor-title" class="t-display" data-enter>
            {page.titleA} <span class="red">{page.titleB}</span>
          </h1>
          <p class="t-lead" data-enter="2" set:html={page.lead} />
          <div class="actions" data-enter="3">
            <a class="btn btn-red btn-nose" href={page.online.href} target="_blank" rel="noopener">
              {page.online.label}<span class="sr-only"> (opens GiveLively in a new tab)</span>
              <span class="nose" aria-hidden="true"><Fragment set:html={ext} /></span>
            </a>
            <a class="btn btn-ghost btn-nose" href="#give">
              {page.give.title}
              <span class="nose" aria-hidden="true"><Fragment set:html={arrow} /></span>
            </a>
          </div>
          <p class="proof" data-enter="4">
            {page.proof} <a class="link" href={page.proofHref}>{page.proofLink}</a>
          </p>
        </div>
        <figure class="frame chamfer-lg shot" data-enter="2">
          <img src={page.photo} alt={page.photoAlt} loading="eager" fetchpriority="high" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="section builds" aria-labelledby="builds-title">
      <div class="wrap">
        <h2 id="builds-title" class="t-h2">{sponsor.buildsTitle}</h2>
        <ul class="build-list">
          {
            sponsor.builds.map((b) => (
              <li>
                <h3 class="t-h3">{b.title}</h3>
                <p>{b.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="give" id="give" aria-labelledby="give-title">
      <div class="wrap">
        <div class="give-head">
          <h2 id="give-title" class="give-title">{page.give.title}</h2>
          <p class="give-intro">{page.give.intro}</p>
        </div>
        <ul class="routes">
          {
            page.give.routes.map((r) => (
              <li>
                <h3 set:html={r.title} />
                <p set:html={r.text} />
                {r.link && (
                  <a class="route-link link" href={r.link.href} target="_blank" rel="noopener">
                    <span set:html={r.link.label} /><span class="sr-only"> (opens in a new tab)</span><Fragment set:html={ext} />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        <div class="give-actions">
          <a class="btn btn-paper" href={page.online.href} target="_blank" rel="noopener">{page.online.label}<span class="sr-only"> (opens GiveLively in a new tab)</span><Fragment set:html={ext} /></a>
          <a class="btn btn-ink" href={packet}>Ask for the sponsor packet</a>
          <p class="contact">{page.give.contactLabel} <a class="link" href={`mailto:${contact.boosters}`}>{contact.boosters}</a></p>
        </div>
        <p class="fine">{page.give.fine}</p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* Nav is absolutely positioned (it floats over the homepage reel); here it sits over the intro. */
  .top { position: relative; z-index: 10; }

  /* ── Intro: the ask ── */
  .intro { background: var(--hull-0); padding: calc(88px + clamp(2.5rem, 1rem + 5vw, 5rem)) 0 var(--section-y); }
  .grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
  .copy { display: grid; gap: 1.6rem; justify-items: start; }
  .copy h1 { font-size: clamp(2.8rem, 1.2rem + 4.6vw, 5.5rem); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; }
  .proof { color: var(--ink-3); font-size: var(--text-small); max-width: 46ch; }
  .proof a { color: var(--ink); font-weight: 700; }
  .shot { aspect-ratio: 4 / 5; }
  .shot img { object-position: 50% 50%; }

  /* ── What it builds: a numbered ledger ── */
  .builds { background: var(--hull-1); }
  .build-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; }
  .build-list li { padding-top: 1.25rem; box-shadow: inset 0 2px 0 var(--red-hot); }
  .build-list p { margin-top: 0.75rem; color: var(--ink-2); max-width: 32ch; }

  /* ── How to give: the page's one red field ── */
  .give {
    position: relative; background: var(--red); color: #fff;
    padding: calc(var(--section-y) + 3rem) 0 var(--section-y);
    clip-path: polygon(0 4rem, 100% 0, 100% 100%, 0 100%);
    margin-top: -4rem;
  }
  .give-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 3rem; align-items: end; }
  .give-title { font-size: clamp(3rem, 1.4rem + 5.2vw, 6rem); font-weight: 900; font-stretch: 62%; line-height: 0.88; text-transform: uppercase; }
  .give-intro { font-size: var(--text-lead); line-height: 1.5; font-stretch: 92%; }
  .routes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 3rem; margin-top: 3.5rem; }
  .routes li { padding-top: 1.1rem; box-shadow: inset 0 2px 0 #fff; }
  .routes h3 { font-weight: 900; font-stretch: 70%; font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
  .routes p { margin-top: 0.6rem; color: rgba(255, 255, 255, 0.88); max-width: 46ch; }
  .give-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-top: 3.5rem; }
  .contact { margin-left: 0.5rem; color: rgba(255, 255, 255, 0.86); font-size: var(--text-small); }
  .contact a { color: #fff; font-weight: 700; }
  .routes p :global(strong) { display: inline-block; margin-top: 0.35rem; color: #fff; font-weight: 750; }
  .route-link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.85rem; font-weight: 750; font-size: 0.8125rem; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; }
  .route-link :global(svg), .give-actions :global(svg) { width: 0.8rem; height: 0.8rem; }
  .route-link :global(em) { margin-right: 0.12em; }
  .fine { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(255, 255, 255, 0.3); max-width: 72ch; font-size: 0.8125rem; line-height: 1.5; color: rgba(255, 255, 255, 0.8); }

  @media (max-width: 1099px) {
    .build-list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 899px) {
    .intro { padding-top: calc(88px + 1.5rem); }
    .grid { grid-template-columns: 1fr; }
    .shot { aspect-ratio: 4 / 3; }
      .actions .btn { flex: 1 1 100%; }
    .give { clip-path: polygon(0 2rem, 100% 0, 100% 100%, 0 100%); margin-top: -2rem; }
    .give-head { grid-template-columns: 1fr; }
    .routes { grid-template-columns: 1fr; }
    .give-actions .btn { flex: 1 1 100%; }
    .contact { margin-left: 0; }
  }
  @media (max-width: 520px) {
    .build-list { grid-template-columns: 1fr; }
  }
</style>
